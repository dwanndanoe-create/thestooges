generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String           @id @default(cuid())
  name                  String
  email                 String           @unique
  passwordHash          String
  isAdmin               Boolean          @default(false)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  bio                   String?
  location              String?
  skills                String[]         @default([])
  conversationsReceived Conversation[]   @relation("ConversationReceiver")
  conversationsStarted  Conversation[]   @relation("ConversationStarter")
  jobs                  Job[]
  applications          JobApplication[]
  sentMessages          Message[]
  sessions              Session[]
  projectsCreated       Project[]
  projectMemberships    ProjectMember[]

  @@index([isActive])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id           String           @id @default(cuid())
  title        String
  description  String
  budget       Int
  location     String?
  skills       String[]         @default([])
  status       JobStatus        @default(OPEN)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  creatorId    String
  creator      User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([creatorId])
  @@index([status])
}

model JobApplication {
  id        String            @id @default(cuid())
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  jobId     String
  userId    String
  job       Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

model Conversation {
  id         String    @id @default(cuid())
  starterId  String
  receiverId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  receiver   User      @relation("ConversationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  starter    User      @relation("ConversationStarter", fields: [starterId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([starterId])
  @@index([receiverId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  content        String
  conversationId String
  senderId       String
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model BlacklistedName {
  id        String   @id @default(cuid())
  name      String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ProjectType
  status      ProjectStatus @default(ACTIVE)
  creatorId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  creator User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members ProjectMember[]

  @@index([creatorId])
  @@index([status])
  @@index([createdAt])
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole   @default(MEMBER)
  status    ProjectMemberStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  method    String?
  createdAt DateTime @default(now())
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProjectType {
  COLLABORATION
  MENTORSHIP
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectMemberRole {
  MEMBER
}

enum ProjectMemberStatus {
  PENDING
  ACCEPTED
  DECLINED
}
